# ─── AI Provider API Keys ────────────────────────────────────────────────────
# Tripo3D (https://platform.tripo3d.ai) – supports both text-to-3D and image-to-3D
TRIPO3D_API_KEY=your_tripo3d_api_key_here

# Meshy (https://www.meshy.ai) – alternative provider
MESHY_API_KEY=your_meshy_api_key_here

# ─── Provider Selection ───────────────────────────────────────────────────────
# Which provider to use for each generation mode
TEXT_TO_3D_PROVIDER=tripo3d
IMAGE_TO_3D_PROVIDER=tripo3d

# ─── Server ──────────────────────────────────────────────────────────────────
PORT=8000
HOST=0.0.0.0
